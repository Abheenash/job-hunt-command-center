# Copy to backend.hcl and fill in. `terraform output backend_hcl` in
# aws-landing-zone/bootstrap prints these values ready to paste.
bucket       = "abheenash-tfstate-<account_id>"
key          = "job-hunt-command-center/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:<account_id>:key/<key-id>"
use_lockfile = true

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json

# Node / React
node_modules/
dist/
build/
.env
.env.*
*.local

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets / local config — NEVER commit
*.pem
client_secret*.json
credentials.json
token.json
config.local.*

# OS / editor
.DS_Store
.idea/
.vscode/

# vendored Lambda deps (installed via requirements.txt before apply)
src/api/pypdf/
src/api/pypdf-*/
src/api/*.dist-info/

# large binary — fetch via scripts/fetch_tectonic_layer.sh
terraform/layers/tectonic/bin/tectonic
terraform/layers/tectonic/cache/

# terraform secrets (Adzuna key etc.)
*.auto.tfvars
terraform/*.auto.tfvars
terraform.tfvars

# iCloud/Finder sync duplicates ("main 2.tf", ".terraform.lock 2.hcl").
# They are byte-copies that Terraform reads as duplicate declarations.
* [0-9].tf
* [0-9].hcl
* [0-9].yaml
* [0-9].yml
* [0-9].py
